{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "thingamablocks/marquee",
	"version": "0.1.0",
	"title": "Marquee",
	"category": "generateblocks",
	"description": "A smooth, endless scrolling strip of logos, images or messages, built from GenerateBlocks elements.",
	"keywords": [
		"marquee",
		"ticker",
		"logos",
		"scroll",
		"carousel",
		"slider",
		"clients"
	],
	"textdomain": "thingamablocks",
	"attributes": {
		"speed": {
			"type": "number",
			"default": 50
		},
		"direction": {
			"type": "string",
			"default": "left",
			"enum": [ "left", "right", "up", "down" ]
		},
		"pauseOnHover": {
			"type": "boolean",
			"default": true
		},
		"fadeEdges": {
			"type": "boolean",
			"default": true
		},
		"fadeWidth": {
			"type": "string",
			"default": "10%"
		},
		"height": {
			"type": "string",
			"default": "20rem"
		},
		"ariaLabel": {
			"type": "string",
			"default": ""
		},
		"anchor": {
			"type": "string"
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"className": true,
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"viewScript": "file:./view.js"
}
