{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/",
	"preferredVersions": { "php": "8.3", "wp": "latest" },
	"features": { "networking": true },
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://downloads.wordpress.org/plugin/generateblocks.latest-stable.zip"
			},
			"ifAlreadyInstalled": "skip",
			"options": { "activate": true }
		},
		{
			"step": "installTheme",
			"themeData": { "resource": "wordpress.org/themes", "slug": "generatepress" },
			"ifAlreadyInstalled": "skip",
			"options": { "activate": true }
		},
		{
			"step": "activatePlugin",
			"pluginPath": "toggle-for-generateblocks/toggle-for-generateblocks.php"
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; global $wp_rewrite; $wp_rewrite->set_permalink_structure('/%postname%/'); $wp_rewrite->flush_rules(); if ( ! get_page_by_path( 'toggle-test' ) ) { wp_insert_post( array( 'post_type' => 'page', 'post_status' => 'publish', 'post_title' => 'Toggle Test', 'post_name' => 'toggle-test', 'post_content' => \"<!-- wp:paragraph -->\\n<p>Playground test page for Toggle for GenerateBlocks. Add a Toggle block here in the editor.</p>\\n<!-- /wp:paragraph -->\" ) ); }"
		}
	]
}
